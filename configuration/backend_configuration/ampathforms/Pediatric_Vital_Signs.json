{
  "name": "Pediatric Vital Signs",
  "description": "Records a child's vital signs at a set date and time, including pulse, blood pressure, oxygen saturation, respiratory rate, temperature, pain score, analgesia given and random blood sugar.",
  "version": "1.0",
  "published": true,
  "uuid": "dfe1b17d-11ad-55ce-9d70-297c28a9d694",
  "retired": false,
  "encounter": "Vitals",
  "pages": [
    {
      "label": "Visit Details",
      "sections": [
        {
          "label": "Encounter Details",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Visit date:",
              "type": "encounterDatetime",
              "required": "true",
              "id": "encDate",
              "questionOptions": {
                "rendering": "date"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                }
              ],
              "readonly": true
            },
            {
              "label": "Provider:",
              "type": "encounterProvider",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "isSearchable": true
              },
              "id": "encProvider",
              "readonly": false
            },
            {
              "label": "Location:",
              "type": "encounterLocation",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "datasource": {
                  "name": "location_datasource",
                  "config": {
                    "tag": "Login Location"
                  }
                }
              },
              "id": "encLocation",
              "readonly": true
            }
          ]
        }
      ]
    },
    {
      "label": "Pedi vitals Assessment",
      "sections": [
        {
          "label": "Assessment",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Date and Time",
              "type": "obs",
              "id": "dateAndTime",
              "questionOptions": {
                "rendering": "datetime",
                "concept": "9e71e964-a2b1-4a91-b3bd-96dd54689723"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                }
              ]
            },
            {
              "label": "Pulse rate (beats/min)",
              "type": "obs",
              "id": "pr",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "230",
                "disallowDecimals": true
              },
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 100 || myValue > 180) : age < 3 ? (myValue < 98 || myValue > 140) : age < 6 ? (myValue < 80 || myValue > 120) : age < 12 ? (myValue < 75 || myValue > 118) : (myValue < 60 || myValue > 100))",
                  "message": "Outside the normal pulse range for the patient's age."
                }
              ]
            },
            {
              "label": "Systolic BP (mmHg)",
              "type": "obs",
              "id": "systolic",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "250",
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (age < 1 ? (myValue < 72 || myValue > 104) : age < 3 ? (myValue < 86 || myValue > 106) : age < 6 ? (myValue < 89 || myValue > 112) : age < 12 ? (myValue < 97 || myValue > 115) : (myValue < 90 || myValue > 120))",
                  "message": "Outside the normal range for the child's age (under 1 year 72-104, 1-2 years 86-106, 3-5 years 89-112, 6-11 years 97-115, 12 years and over 90-120 mmHg)."
                }
              ],
              "hideSteppers": true,
              "questionInfo": "Normal range depends on age: under 1 year 72-104, 1-2 years 86-106, 3-5 years 89-112, 6-11 years 97-115, 12 years and over 90-120 mmHg."
            },
            {
              "label": "Diastolic BP (mmHg)",
              "type": "obs",
              "id": "diastolic",
              "questionOptions": {
                "rendering": "number",
                "concept": "5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "150",
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (age < 1 ? (myValue < 37 || myValue > 56) : age < 3 ? (myValue < 42 || myValue > 63) : age < 6 ? (myValue < 46 || myValue > 72) : age < 12 ? (myValue < 57 || myValue > 76) : (myValue < 60 || myValue > 90))",
                  "message": "Outside the normal range for the child's age (under 1 year 37-56, 1-2 years 42-63, 3-5 years 46-72, 6-11 years 57-76, 12 years and over 60-90 mmHg)."
                }
              ],
              "hideSteppers": true,
              "questionInfo": "Normal range depends on age: under 1 year 37-56, 1-2 years 42-63, 3-5 years 46-72, 6-11 years 57-76, 12 years and over 60-90 mmHg."
            },
            {
              "label": "SPO2",
              "type": "obs",
              "id": "spo2",
              "questionOptions": {
                "rendering": "number",
                "concept": "0c5ec4fa-f41a-4a6d-bd07-969872b69165",
                "min": "0",
                "step": 0.01
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && myValue <= 90",
                  "message": "SPO2 is below the normal range (>90%)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Respiratory rate (breaths/min)",
              "type": "obs",
              "id": "rr",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "99",
                "disallowDecimals": true
              },
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 30 || myValue > 53) : age < 3 ? (myValue < 22 || myValue > 37) : age < 6 ? (myValue < 20 || myValue > 28) : age < 12 ? (myValue < 18 || myValue > 25) : (myValue < 12 || myValue > 20))",
                  "message": "Outside the normal respiratory rate for the patient's age."
                }
              ]
            },
            {
              "label": "Temperature (°C)",
              "type": "obs",
              "id": "temprature",
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "25",
                "step": 0.01,
                "max": "43"
              },
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 36.5 || myValue > 37.5) : (myValue < 35 || myValue > 37.5))",
                  "message": "Outside the normal range (36.5-37.5 °C for infants, 35-37.5 °C otherwise)."
                }
              ]
            },
            {
              "label": "Pain Score",
              "type": "obs",
              "id": "painScore",
              "questionOptions": {
                "rendering": "select",
                "concept": "166000AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "answers": [
                  {
