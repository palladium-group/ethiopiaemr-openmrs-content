{
  "name": "Pediatric Vital Signs",
  "description": "Records a child's vital signs at a set date and time, including pulse, blood pressure, oxygen saturation, respiratory rate, temperature, pain score, analgesia given and random blood sugar.",
  "version": "1.0",
  "published": true,
  "uuid": "dfe1b17d-11ad-55ce-9d70-297c28a9d694",
  "retired": false,
  "encounter": "Vitals",
  "pages": [
    {
      "label": "Visit Details",
      "sections": [
        {
          "label": "Encounter Details",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Visit date:",
              "type": "encounterDatetime",
              "required": "true",
              "id": "encDate",
              "questionOptions": {
                "rendering": "date"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                }
              ],
              "readonly": true
            },
            {
              "label": "Provider:",
              "type": "encounterProvider",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "isSearchable": true
              },
              "id": "encProvider",
              "readonly": false
            },
            {
              "label": "Location:",
              "type": "encounterLocation",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "datasource": {
                  "name": "location_datasource",
                  "config": {
                    "tag": "Login Location"
                  }
                }
              },
              "id": "encLocation",
              "readonly": true
            }
          ]
        }
      ]
    },
    {
      "label": "Pedi vitals Assessment",
      "sections": [
        {
          "label": "Assessment",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Date and Time",
              "type": "obs",
              "id": "dateAndTime",
              "questionOptions": {
                "rendering": "datetime",
                "concept": "9e71e964-a2b1-4a91-b3bd-96dd54689723"
              }
            },
            {
              "label": "PR",
              "type": "obs",
              "id": "pr",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01
              },
              "hideSteppers": true
            },
            {
              "label": "Systolic",
              "type": "obs",
              "id": "systolic",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 90 || myValue > 120)",
                  "message": "Value is outside the normal range (90-120 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Diastolic",
              "type": "obs",
              "id": "diastolic",
              "questionOptions": {
                "rendering": "number",
                "concept": "5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 90)",
                  "message": "Value is outside the normal range (60-90 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "SPO2",
              "type": "obs",
              "id": "spo2",
              "questionOptions": {
                "rendering": "number",
                "concept": "0c5ec4fa-f41a-4a6d-bd07-969872b69165",
                "min": "0",
                "step": 0.01
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && myValue <= 90",
                  "message": "SPO2 is below the normal range (>90%)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "RR",
              "type": "obs",
              "id": "rr",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01
              },
              "hideSteppers": true
            },
            {
              "label": "Temprature",
              "type": "obs",
              "id": "temprature",
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "25",
                "step": 0.01
              },
              "hideSteppers": true
            },
            {
              "label": "Pain Score",
              "type": "obs",
