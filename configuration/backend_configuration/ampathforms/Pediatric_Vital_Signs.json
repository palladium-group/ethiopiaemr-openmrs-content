                    "label": "Moderate to Sever (4-6)"
                  },
                  {
                    "concept": "159409AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Very Sever (7-9)"
                  },
                  {
                    "concept": "07d1ccf4-afcd-4e4b-b329-e68b900968eb",
                    "label": "Worst possible pain (10)"
                  }
                ]
              }
            },
            {
              "label": "Anti pain given?",
              "type": "obs",
              "id": "antiPainGiven",
              "questionOptions": {
                "rendering": "radio",
                "concept": "649de9d2-6718-5dec-9382-5c7f33cabcd4",
                "answers": [
                  {
                    "concept": "1065AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Yes"
                  },
                  {
                    "concept": "1066AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "No"
                  }
                ]
              }
            },
            {
              "label": "RBS(mg/dl)",
              "type": "obs",
              "id": "rbsMgDl",
              "questionOptions": {
                "rendering": "number",
                "concept": "d0d107f7-9452-4129-a209-b9a4d1b46d4a",
                "min": "0",
                "step": 0.01
              },
              "hideSteppers": true
            }
          ]
        }
      ]
    }
  ],
