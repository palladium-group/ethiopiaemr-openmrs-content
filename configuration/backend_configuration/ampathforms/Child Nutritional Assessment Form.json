        {
          "label": "Child Nutritional Assessment, Anthropometric Measurement",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Length/Height",
              "type": "obs",
              "id": "lengthHeight",
              "questionOptions": {
                "rendering": "number",
                "concept": "5090AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "10",
                "step": 0.01,
                "max": "272"
              },
              "hideSteppers": true
            },
            {
              "label": "Weight (kg)",
              "type": "obs",
              "id": "weight",
              "questionOptions": {
                "rendering": "number",
                "concept": "5089AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01,
                "max": "250"
              },
              "questionInfo": "Kilograms.",
              "hideSteppers": true
            },
            {
              "label": "BMI",
              "type": "obs",
              "id": "bmi",
              "questionOptions": {
                "rendering": "number",
                "concept": "1342AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01,
                "calculate": {
                  "calculateExpression": "calcBMI(lengthHeight,weight)"
                },
                "max": "100"
              },
              "hideSteppers": true
            },
            {
              "label": "MUAC (cm)",
              "type": "obs",
              "id": "muac",
              "questionOptions": {
                "rendering": "number",
                "concept": "aae2be11-0e07-497d-8e7c-a5b74fbd7cb0",
                "min": "5",
                "step": 0.1,
                "max": "60"
              },
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && ((age < 5 && myValue < 12.5) || (age >= 18 && myValue < 21))",
                  "message": "MUAC below the cut-off (under 5 years: 12.5 cm; adults: 21 cm): screen for acute malnutrition."
                }
              ]
            },
            {
              "label": "Z-Score",
              "type": "obs",
              "id": "zScore",
              "questionOptions": {
                "rendering": "text",
                "concept": "6f76bbf3-9880-4571-a9b9-7efb3d345be0"
              }
            },
            {
              "label": "Head Circumference Z-Score",
              "type": "obs",
              "id": "headCircumferenceZScore",
              "questionOptions": {
                "rendering": "text",
                "concept": "88f56373-0050-428a-be36-3826bba449c6"
              }
            },
            {
              "label": "Weight for Height Z-Score",
              "type": "obs",
              "id": "weightForHeightZScore",
              "questionOptions": {
                "rendering": "text",
                "concept": "2dabfcfe-1e70-4e88-837a-79531073b040",
                "calculate": {
                  "calculateExpression": "(isEmpty(lengthHeight) || isEmpty(weight)) ? '' : ((calcWeightForHeightZscore(Number(lengthHeight),Number(weight)) == null) ? '' : String(Number(calcWeightForHeightZscore(Number(lengthHeight),Number(weight)))))"
                }
              },
              "readonly": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (Number(myValue) < -5 || Number(myValue) > 5)",
                  "message": "Outside -5 to +5: re-check the weight, height and age."
                }
              ]
            },
            {
              "label": "Length Height For Age Z-Score",
              "type": "obs",
              "id": "lengthHeightForAgeZScore",
              "questionOptions": {
                "rendering": "text",
                "concept": "75878fd7-d3a0-44e0-8543-d2027def679d",
                "calculate": {
                  "calculateExpression": "(isEmpty(lengthHeight)) ? '' : ((calcHeightForAgeZscore(Number(lengthHeight)) == null) ? '' : String(Number(calcHeightForAgeZscore(Number(lengthHeight)))))"
                }
              },
              "readonly": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (Number(myValue) < -5 || Number(myValue) > 5)",
                  "message": "Outside -5 to +5: re-check the weight, height and age."
                }
              ]
            },
