                "min": "0",
                "step": 0.01,
                "max": "230"
              },
              "questionInfo": "Beats per minute. Normal range 80-120 bpm.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 80 || myValue > 120)",
                  "message": "Value is outside the normal range (80-120 bpm)."
