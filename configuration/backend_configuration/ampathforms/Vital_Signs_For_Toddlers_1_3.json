    },
    {
      "label": "Vital Sign for Toddlers (1-3 Years) Assessment",
      "sections": [
        {
          "label": "Assessment",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Pulse rate (beats/min)",
              "type": "obs",
              "id": "pulseRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "230",
                "disallowDecimals": true
              },
              "questionInfo": "Beats per minute. Normal range 98-140 bpm.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 98 || myValue > 140)",
                  "message": "Value is outside the normal range (98-140 bpm)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Temperature (°C)",
              "type": "obs",
              "id": "temperature",
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "25",
                "step": 0.01,
                "max": "43"
              },
              "questionInfo": "Degrees Celsius, one decimal place.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 35 || myValue > 37.5)",
                  "message": "Value is outside the normal range (35-37.5 deg C)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Respiratory rate (breaths/min)",
              "type": "obs",
              "id": "respiratoryRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "99",
                "disallowDecimals": true
              },
              "questionInfo": "Breaths per minute. Normal range 22-37 breaths/min.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 22 || myValue > 37)",
                  "message": "Value is outside the normal range (22-37 breaths/min)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "SpO2 (%)",
              "type": "obs",
              "id": "spo2",
              "questionOptions": {
                "rendering": "number",
                "concept": "5092AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "100",
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && myValue <= 90",
                  "message": "SPO2 is below the normal range (>90%)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Weight (kg)",
              "type": "obs",
              "id": "weight",
              "questionOptions": {
                "rendering": "number",
                "concept": "5089AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01,
                "max": "250"
              },
              "questionInfo": "Kilograms.",
              "hideSteppers": true
            },
            {
              "label": "Length",
              "type": "obs",
              "id": "length",
              "questionOptions": {
                "rendering": "number",
                "concept": "97d878cf-4807-480a-a236-8f8f416f7be1",
                "min": "0",
                "step": 0.01
              },
              "hideSteppers": true
            },
            {
              "label": "Weight for Length",
              "type": "obs",
              "id": "weightForLength",
              "questionOptions": {
                "rendering": "number",
                "concept": "31f2383e-2d35-5cbc-8e43-966e714ee934",
                "calculate": {
                  "calculateExpression": "(isEmpty(length) || isEmpty(weight)) ? '' : ((calcWeightForHeightZscore(Number(length),Number(weight)) == null) ? '' : Number(calcWeightForHeightZscore(Number(length),Number(weight))))"
                }
              },
              "readonly": true,
              "hideSteppers": true
            },
            {
              "label": "Weight for age(Z-score)",
              "type": "obs",
              "id": "weightForAgeZScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "162584AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
              },
              "hideSteppers": true
            },
            {
              "label": "Length for age",
              "type": "obs",
              "id": "lengthForAge",
              "questionOptions": {
                "rendering": "number",
                "concept": "0670ae82-9fca-5883-9c22-38a067859bee",
                "calculate": {
                  "calculateExpression": "(isEmpty(length)) ? '' : ((calcHeightForAgeZscore(Number(length)) == null) ? '' : Number(calcHeightForAgeZscore(Number(length))))"
                }
              },
              "readonly": true,
              "hideSteppers": true
            },
            {
              "label": "MUAC (cm)",
              "type": "obs",
              "id": "muac",
              "questionOptions": {
                "rendering": "number",
                "concept": "aae2be11-0e07-497d-8e7c-a5b74fbd7cb0",
                "min": "5",
                "step": 0.1,
                "max": "60"
              },
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && ((age < 5 && myValue < 12.5) || (age >= 18 && myValue < 21))",
                  "message": "MUAC below the cut-off (under 5 years: 12.5 cm; adults: 21 cm): screen for acute malnutrition."
                }
              ]
            },
            {
              "label": "RBS",
              "type": "obs",
              "id": "rbs",
              "questionOptions": {
                "rendering": "number",
                "concept": "887AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0"
              },
              "hideSteppers": true
            }
          ]
        },
        {
          "label": "Vital Toddler BP",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Systolic BP (mmHg)",
              "type": "obs",
              "id": "systolic",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "250",
                "disallowDecimals": true
              },
              "questionInfo": "Millimetres of mercury. Normal range 86-106 mmHg.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 86 || myValue > 106)",
                  "message": "Value is outside the normal range (86-106 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Diastolic BP (mmHg)",
              "type": "obs",
              "id": "diastolicBp",
              "questionOptions": {
                "rendering": "number",
                "concept": "5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "150",
                "disallowDecimals": true
              },
              "questionInfo": "Millimetres of mercury. Normal range 42-63 mmHg.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 42 || myValue > 63)",
                  "message": "Value is outside the normal range (42-63 mmHg)."
                }
              ],
              "hideSteppers": true
            }
          ]
        }
      ]
    }
  ],
  "processor": "EncounterFormProcessor",
