{
  "name": "Vital Sign for Toddlers (1-3 Years)",
  "description": "Documents vital signs and growth for toddlers aged 1 to 3 years, including pulse, temperature, respiratory rate, oxygen saturation, blood pressure, weight, length, growth z-scores, mid-upper arm circumference and random blood sugar.",
  "version": "1.0",
  "published": true,
  "uuid": "52ce52e1-a716-4687-989b-964d04148879",
  "retired": false,
  "encounter": "Consultation",
  "pages": [
    {
      "label": "Visit Details",
      "sections": [
        {
          "label": "Encounter Details",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Visit date:",
              "type": "encounterDatetime",
              "required": "true",
              "id": "encDate",
              "questionOptions": {
                "rendering": "date"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                }
              ],
