        {
          "label": "Blood Pressure",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Systolic BP (mmHg)",
              "type": "obs",
              "required": false,
              "id": "systolic",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "max": "250",
                "disallowDecimals": true,
                "step": 1
              },
              "validators": [
                {
                  "type": "warning",
                  "jsExpression": "value > 140 || value < 90 ? 'Abnormal systolic BP (Normal: 90-140 mmHg)' : null"
                },
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 72 || myValue > 104) : age < 3 ? (myValue < 86 || myValue > 106) : age < 6 ? (myValue < 89 || myValue > 112) : age < 12 ? (myValue < 97 || myValue > 115) : (myValue < 90 || myValue > 139))",
                  "message": "Outside the normal systolic range for the patient's age."
                }
              ]
            },
            {
              "label": "Diastolic BP (mmHg)",
              "type": "obs",
              "required": false,
              "id": "diastolic",
              "questionOptions": {
                "rendering": "number",
                "concept": "5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "max": "150",
                "disallowDecimals": true,
                "step": 1
              },
              "validators": [
                {
                  "type": "warning",
                  "jsExpression": "value > 90 || value < 60 ? 'Abnormal diastolic BP (Normal: 60-90 mmHg)' : null"
                },
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 37 || myValue > 56) : age < 3 ? (myValue < 42 || myValue > 63) : age < 6 ? (myValue < 46 || myValue > 72) : age < 12 ? (myValue < 57 || myValue > 76) : (myValue < 60 || myValue > 89))",
                  "message": "Outside the normal diastolic range for the patient's age."
                }
              ]
            },
            {
              "label": "Posture",
              "type": "obs",
