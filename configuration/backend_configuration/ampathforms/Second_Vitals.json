              },
              "questionInfo": "Normal range: 60-90 mmHg",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 90)",
                  "message": "Value is outside the normal range (60-90 mmHg)."
                }
              ],
              "hideSteppers": true
            }
          ]
        },
        {
          "label": "Temperature",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Temperature (°C)",
