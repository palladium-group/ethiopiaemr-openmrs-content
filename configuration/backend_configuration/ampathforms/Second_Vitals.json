    {
      "label": "Second vital Second Vital Signs",
      "sections": [
        {
          "label": "Pulse",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Pulse rate (bpm)",
              "type": "obs",
              "id": "pulseRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Normal range: 60-100 bpm",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 100)",
                  "message": "Value is outside the normal range (60-100 bpm)."
                }
              ],
              "hideSteppers": true
            }
          ]
        },
        {
          "label": "Blood Pressure without posture",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Systolic BP (mmHg)",
