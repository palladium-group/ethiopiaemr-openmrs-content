              },
              "hide": {
                "hideWhenExpression": "lafpTypeRemoved !== '5622AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'"
              }
            },
            {
              "label": "Reason for removal",
              "type": "obs",
              "required": "false",
              "id": "removalReason",
              "questionOptions": {
                "rendering": "checkbox",
                "concept": "a192b3c4-d5e6-f789-0123-456789abcdef",
                "answers": [
                  {
                    "concept": "9647586a-1081-901c-6345-789cdef01234",
