                  {
                    "concept": "1869708c-3203-123e-8567-9ef012345678",
                    "label": "Myths and Misconception"
                  },
                  {
                    "concept": "5622AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Other"
                  }
                ]
              },
              "questionInfo": "Primary reason why the LAFP method was removed"
            },
            {
              "label": "Other reason for removal, specify",
              "type": "obs",
              "id": "removalReasonOther",
              "questionOptions": {
                "rendering": "text",
                "concept": "94fc3e3f-dbf2-5455-8763-d40a327d62d6"
              },
              "hide": {
                "hideWhenExpression": "!(!isEmpty(removalReason) && arrayContains(removalReason, '5622AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'))"
              }
            },
            {
              "label": "LAFP method duration used (months)",
              "type": "obs",
              "id": "lafpDurationMonths",
              "questionOptions": {
                "rendering": "number",
                "concept": "baee2853-f838-5b70-97fe-759fda487e97",
                "calculate": {
                  "calculateExpression": "(isEmpty(dateInsertion) || isEmpty(removalDate)) ? null : Math.max(0, Math.floor((new Date(removalDate) - new Date(dateInsertion)) / 2629800000))"
                },
                "step": 1,
                "disallowDecimals": true,
                "min": "0"
              },
              "readonly": true
            }
          ]
        }
      ]
    },
