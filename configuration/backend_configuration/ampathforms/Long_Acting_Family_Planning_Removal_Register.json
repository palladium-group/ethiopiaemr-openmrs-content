        {
          "label": "Removal Information",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Date of Removal service provided",
              "type": "obs",
              "required": "false",
              "id": "removalDate",
              "questionOptions": {
                "rendering": "date",
                "concept": "5474bf3c-ab47-441f-848a-9640cb5c6056",
                "calculate": {
                  "calculateExpression": "isEmpty(removalDate) ? today() : removalDate"
                }
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                },
                {
                  "type": "js_expression",
                  "message": "The removal date cannot be before the insertion date.",
                  "failsWhenExpression": "!isEmpty(removalDate) && !isEmpty(dateInsertion) && new Date(removalDate) < new Date(dateInsertion)"
                }
              ],
              "questionInfo": "Date when the LAFP removal procedure was performed"
            },
            {
              "label": "LAFP type removed",
              "type": "obs",
              "id": "lafpTypeRemoved",
