            {
              "label": "Pulse rate (beats/min)",
              "type": "obs",
              "id": "pulseRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "230",
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 100 || myValue > 160)",
                  "message": "Value is outside the normal range (100-160 bpm)."
                }
              ],
              "hideSteppers": true,
              "questionInfo": "Normal range 100-160 bpm."
            },
            {
              "label": "Respiratory rate (breaths/min)",
              "type": "obs",
              "id": "respiratoryRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "99",
                "disallowDecimals": true
