              "questionInfo": "Breaths per minute. Normal range 30-60 breaths/min.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 30 || myValue > 60)",
                  "message": "Value is outside the normal range (30-60 breaths/min)."
