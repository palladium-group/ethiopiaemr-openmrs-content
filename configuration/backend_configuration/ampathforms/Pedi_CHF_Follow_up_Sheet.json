{
  "name": "Pediatric CHF Follow-up Sheet",
  "description": "Used to follow children with congestive heart failure (CHF), recording pulse, respiratory rate, oxygen saturation, temperature, blood pressure, fluid input and output and weight, with the reviewing physician's name.",
  "version": "1.0",
  "published": true,
  "uuid": "c14fcd14-d5a0-5fe1-a116-672f3dcc6ab9",
  "retired": false,
  "encounter": "Consultation",
  "pages": [
    {
      "label": "Visit Details",
      "sections": [
        {
          "label": "Encounter Details",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Visit date:",
              "type": "encounterDatetime",
              "required": "true",
              "id": "encDate",
              "questionOptions": {
                "rendering": "date"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                }
              ],
              "readonly": true
            },
            {
              "label": "Provider:",
              "type": "encounterProvider",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "isSearchable": true
              },
              "id": "encProvider",
              "readonly": false
            },
            {
              "label": "Location:",
              "type": "encounterLocation",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "datasource": {
                  "name": "location_datasource",
                  "config": {
                    "tag": "Login Location"
                  }
                }
              },
              "id": "encLocation",
              "readonly": true
            }
          ]
        }
      ]
    },
    {
      "label": "Pediatric CHF Follow-up Sheet Assessment",
      "sections": [
        {
          "label": "Assessment",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Pulse rate (beats/min)",
              "type": "obs",
              "id": "pr",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "230",
                "disallowDecimals": true
              },
              "questionInfo": "Beats per minute.",
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 100 || myValue > 180) : age < 3 ? (myValue < 98 || myValue > 140) : age < 6 ? (myValue < 80 || myValue > 120) : age < 12 ? (myValue < 75 || myValue > 118) : (myValue < 60 || myValue > 100))",
                  "message": "Outside the normal pulse range for the patient's age."
                }
              ]
            },
            {
              "label": "Respiratory rate (breaths/min)",
              "type": "obs",
              "id": "rr",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "99",
                "disallowDecimals": true
              },
              "questionInfo": "Breaths per minute.",
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 30 || myValue > 53) : age < 3 ? (myValue < 22 || myValue > 37) : age < 6 ? (myValue < 20 || myValue > 28) : age < 12 ? (myValue < 18 || myValue > 25) : (myValue < 12 || myValue > 20))",
                  "message": "Outside the normal respiratory rate for the patient's age."
                }
              ]
            },
            {
              "label": "SpO2 (%)",
              "type": "obs",
              "id": "spo2",
              "questionOptions": {
                "rendering": "number",
                "concept": "5092AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "100",
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && myValue <= 90",
                  "message": "SPO2 is below the normal range (>90%)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Temperature (°C)",
              "type": "obs",
              "id": "temprature",
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "25",
                "step": 0.01,
                "max": "43"
              },
              "questionInfo": "Degrees Celsius, one decimal place.",
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 36.5 || myValue > 37.5) : (myValue < 35 || myValue > 37.5))",
                  "message": "Outside the normal range (36.5-37.5 °C for infants, 35-37.5 °C otherwise)."
                }
              ]
            },
            {
              "label": "Input",
              "type": "obs",
              "id": "input",
              "questionOptions": {
                "rendering": "number",
                "concept": "e6c5a098-f9d8-45fa-aa0c-8cc30e27a79f"
              },
              "hideSteppers": true
            },
            {
              "label": "Output",
              "type": "obs",
              "id": "output",
              "questionOptions": {
                "rendering": "number",
                "concept": "18dd029d-81ee-5d57-9bcb-abb1b21ba17e"
              },
              "hideSteppers": true
            },
            {
              "label": "Weight (kg)",
              "type": "obs",
              "id": "weight",
              "questionOptions": {
                "rendering": "number",
                "concept": "5089AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01,
                "max": "250"
              },
              "questionInfo": "Kilograms.",
              "hideSteppers": true
            },
            {
              "label": "Signs of heart failure",
              "type": "obs",
              "id": "signsOfHeartFailure",
              "questionOptions": {
                "rendering": "checkbox",
                "concept": "689a0004-526a-500a-82fa-e00b5e3c7d0d",
                "answers": [
                  {
                    "concept": "f4a4ded7-6875-4631-a931-6055171be868",
                    "label": "Tachypnea"
                  },
                  {
                    "concept": "9eb8b6fb-cf70-4bee-b63d-276a5b9d6bb1",
                    "label": "Tachycardia"
                  },
                  {
                    "concept": "5008AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Hepatomegaly"
                  },
                  {
                    "concept": "550AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Gallop rhythm"
                  },
                  {
                    "concept": "5127AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Crepitations"
                  },
                  {
                    "concept": "f919c4d1-0369-4b7e-b8c4-21893e379991",
                    "label": "Raised JVP"
                  },
                  {
                    "concept": "460AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Edema"
                  },
                  {
                    "concept": "140941AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Excessive sweating (e.g. during feeds)"
                  }
                ]
              }
            },
            {
              "label": "Feeding status",
              "type": "obs",
              "id": "feedingStatus",
              "questionOptions": {
                "rendering": "radio",
                "concept": "5fb2e238-5c23-4893-9273-f5baf038a01d",
                "answers": [
                  {
                    "concept": "166909AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Adequate"
                  },
                  {
                    "concept": "163794AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Inadequate"
                  }
                ]
              }
            },
            {
              "label": "Physician Name",
              "type": "obs",
              "id": "physicianName",
              "questionOptions": {
                "rendering": "text",
                "concept": "7416af1a-7c60-4c55-a61a-5fe0cf5e8229"
              }
            }
          ]
        },
        {
          "label": "Blood Pressure",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Systolic BP (mmHg)",
              "type": "obs",
              "id": "systolicBloodPressure",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "250",
                "disallowDecimals": true
              },
              "questionInfo": "Millimetres of mercury.",
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 72 || myValue > 104) : age < 3 ? (myValue < 86 || myValue > 106) : age < 6 ? (myValue < 89 || myValue > 112) : age < 12 ? (myValue < 97 || myValue > 115) : (myValue < 90 || myValue > 139))",
                  "message": "Outside the normal systolic range for the patient's age."
                }
              ]
            },
            {
              "label": "Diastolic BP (mmHg)",
              "type": "obs",
              "id": "diastolicBloodPressure",
              "questionOptions": {
                "rendering": "number",
                "concept": "5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "150",
                "disallowDecimals": true
              },
              "questionInfo": "Millimetres of mercury.",
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (age < 1 ? (myValue < 37 || myValue > 56) : age < 3 ? (myValue < 42 || myValue > 63) : age < 6 ? (myValue < 46 || myValue > 72) : age < 12 ? (myValue < 57 || myValue > 76) : (myValue < 60 || myValue > 89))",
                  "message": "Outside the normal diastolic range for the patient's age."
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "processor": "EncounterFormProcessor",
  "referencedForms": []
}