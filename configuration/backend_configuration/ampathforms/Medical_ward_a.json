                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Normal range: 60-100 beats/min",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 100)",
