    {
      "label": "Visit Details",
      "sections": [
        {
          "label": "Encounter Details",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Visit date:",
              "type": "encounterDatetime",
              "required": "true",
              "id": "encDate",
              "questionOptions": {
                "rendering": "date"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                }
              ],
              "readonly": true
            },
            {
              "label": "Provider:",
              "type": "encounterProvider",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "isSearchable": true
              },
              "id": "encProvider",
              "readonly": false
            },
            {
              "label": "Location:",
              "type": "encounterLocation",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "datasource": {
                  "name": "location_datasource",
                  "config": {
                    "tag": "Login Location"
                  }
                }
              },
              "id": "encLocation",
              "readonly": true
            }
          ]
        }
      ]
    },
    {
      "label": "Central Triage Assessment",
      "sections": [
        {
          "label": "Vitals",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Systolic (mmHg)",
              "type": "obs",
              "id": "systolicBP",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Normal range: 90-120 mmHg",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 90 || myValue > 120)",
                  "message": "Systolic BP is outside the normal range (90-120 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Diastolic (mmHg)",
              "type": "obs",
              "id": "diastolicBP",
              "questionOptions": {
                "rendering": "number",
                "concept": "5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Normal range: 60-90 mmHg",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 90)",
                  "message": "Diastolic BP is outside the normal range (60-90 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Posture",
              "type": "obs",
              "id": "posture",
              "questionOptions": {
                "rendering": "radio",
                "concept": "159633AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "answers": [
                  {
                    "concept": "159630AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Sitting"
                  },
                  {
                    "concept": "159629AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Supine"
                  }
                ]
              }
            },
            {
              "label": "Heart Rate (bpm)",
              "type": "obs",
              "id": "pulse",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Normal range: 60-100 bpm",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 100)",
                  "message": "Heart rate is outside the normal range (60-100 bpm)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Respiratory Rate (breaths/min)",
              "type": "obs",
              "id": "respiratoryRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Normal range: 16-24 breaths/min",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 16 || myValue > 24)",
                  "message": "Respiratory rate is outside the normal range (16-24 breaths/min)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Temperature (°C)",
              "type": "obs",
              "id": "temperature",
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "25",
                "max": "43",
                "step": "0.01"
              },
              "questionInfo": "Normal range: 36.5-37.5 °C",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue >= 37.5 || myValue < 35)",
                  "message": "Temperature is outside the normal range (35-37.5 °C)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "SPO2 (%)",
              "type": "obs",
              "id": "spo2",
              "questionOptions": {
                "rendering": "number",
                "concept": "5092AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "max": "100",
                "step": "0.01"
              },
              "questionInfo": "Normal: >90%",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && myValue <= 90",
                  "message": "SPO2 is below the normal range (>90%)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Pain Score (0-10)",
              "type": "obs",
              "id": "painScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "160287AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "max": "10",
                "step": "1"
              },
              "hideSteppers": true
            }
          ]
        },
        {
          "label": "Anthropometry",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Height (cm)",
              "type": "obs",
              "id": "height",
              "questionOptions": {
                "rendering": "number",
                "concept": "5090AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "10",
                "step": "0.01"
              },
              "questionInfo": "Allowed range: 30-300 cm",
              "hideSteppers": true
            },
            {
              "label": "Weight (kg)",
              "type": "obs",
              "id": "weight",
              "questionOptions": {
                "rendering": "number",
                "concept": "5089AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Kilograms.",
              "hideSteppers": true
            },
            {
              "label": "BMI (kg/m²)",
              "type": "obs",
              "id": "bmi",
              "questionOptions": {
                "rendering": "number",
                "concept": "1342AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "calculate": {
                  "calculateExpression": "calcBMI(height,weight)"
                },
                "step": "0.01"
              },
              "hideSteppers": true
            },
            {
              "label": "BMI Category",
              "type": "obs",
              "id": "bmiCategory",
              "questionOptions": {
                "rendering": "radio",
                "concept": "255b89fc-8a01-4dae-90b3-613d65bb76bb",
                "answers": [
                  {
                    "concept": "f1ac86a2-5934-49c5-aecc-16426e6b1d59",
                    "label": "Underweight"
                  },
                  {
                    "concept": "ad106589-fb33-4ce5-9159-0cf793996bce",
                    "label": "Healthy Weight"
                  },
                  {
                    "concept": "590a7581-714a-4b47-a1c9-712501889e44",
                    "label": "Overweight"
                  },
                  {
                    "concept": "9f2f66bf-dc75-47ac-b201-c891a9d5bbd6",
                    "label": "Obese"
                  }
                ]
              },
              "questionInfo": "Auto-classified from BMI: <18.5 Underweight, 18.5-24.9 Healthy Weight, 25.0-29.9 Overweight, ≥30.0 Obese."
            },
            {
              "label": "Body Surface Area (m²)",
              "type": "obs",
              "id": "bodySurfaceArea",
              "readonly": true,
              "questionOptions": {
                "rendering": "number",
                "concept": "980AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "calculate": {
                  "calculateExpression": "height && weight ? Math.round(Math.sqrt((Number(height) * Number(weight)) / 3600) * 100) / 100 : null"
                },
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Body surface area (BSA). Auto-calculated from height (cm) and weight (kg) using the Mosteller formula. Used to assist drug dosing calculations.",
              "hideSteppers": true
            }
          ]
        }
      ]
    },
