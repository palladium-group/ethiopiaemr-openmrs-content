{
  "name": "Vital Sign For Adolescents (above 12)",
  "description": "Records vital signs and growth measurements for adolescents older than 12 years, including blood pressure, pulse, temperature, oxygen saturation, weight, height, BMI, mid-upper arm circumference and random blood sugar.",
  "version": "1.0",
  "published": true,
  "uuid": "eef4c81e-8fce-5726-076b-5451f0d2b703",
  "retired": false,
  "encounter": "Vitals",
  "pages": [
    {
      "label": "Visit Details",
      "sections": [
        {
          "label": "Encounter Details",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Visit date:",
              "type": "encounterDatetime",
              "required": "true",
              "id": "encDate",
              "questionOptions": {
                "rendering": "date"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                }
              ],
              "readonly": true
            },
            {
              "label": "Provider:",
              "type": "encounterProvider",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "isSearchable": true
              },
              "id": "encProvider",
              "readonly": false
            },
            {
              "label": "Location:",
              "type": "encounterLocation",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "datasource": {
                  "name": "location_datasource",
                  "config": {
                    "tag": "Login Location"
                  }
                }
              },
              "id": "encLocation",
              "readonly": true
            }
          ]
        }
      ]
    },
    {
      "label": "Vital Sign For Adolescents (above 12) Assessment",
      "sections": [
        {
          "label": "Assessment",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Pulse Rate",
              "type": "obs",
              "id": "pulseRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 100)",
                  "message": "Value is outside the normal range (60-100 bpm)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Respiratory Rate (breaths/min)",
              "type": "obs",
              "id": "respiratoryRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01
              },
              "questionInfo": "Normal range: 16-24 breaths/min",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 16 || myValue > 24)",
                  "message": "Value is outside the normal range (16-24 breaths/min)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Temperature",
              "type": "obs",
              "id": "temperature",
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "25",
                "step": 0.01
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 35 || myValue > 37.5)",
                  "message": "Value is outside the normal range (35-37.5 deg C)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "SPO2",
              "type": "obs",
              "id": "spo2",
              "questionOptions": {
                "rendering": "number",
                "concept": "0c5ec4fa-f41a-4a6d-bd07-969872b69165",
                "min": "0",
                "step": 0.01
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && myValue <= 90",
                  "message": "SPO2 is below the normal range (>90%)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Weight (kg)",
              "type": "obs",
              "id": "weight",
              "questionOptions": {
                "rendering": "number",
                "concept": "5089AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01
              },
              "questionInfo": "Kilograms.",
              "hideSteppers": true
            },
            {
              "label": "Height (cm)",
              "type": "obs",
              "id": "height",
              "questionOptions": {
                "rendering": "number",
                "concept": "5090AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "10",
                "step": 0.01
              },
              "questionInfo": "Centimetres.",
              "hideSteppers": true
            },
            {
              "label": "BMI",
              "type": "obs",
              "id": "bmi",
              "questionOptions": {
                "rendering": "number",
                "concept": "8dbc97c1-cc29-4823-b10e-58f03773588d",
                "min": "0",
                "step": 0.01,
                "calculate": {
                  "calculateExpression": "calcBMI(height,weight)"
                }
              },
              "hideSteppers": true
            },
            {
              "label": "RBS",
              "type": "obs",
              "id": "rbs",
              "questionOptions": {
                "rendering": "text",
                "concept": "590ff73f-c56c-43ec-bf41-7a6148072b78"
              }
            },
            {
              "label": "MUAC",
              "type": "obs",
              "id": "muac",
              "questionOptions": {
                "rendering": "number",
                "concept": "aae2be11-0e07-497d-8e7c-a5b74fbd7cb0",
                "min": "0",
                "step": 0.01
              },
              "hideSteppers": true
            }
          ]
        },
        {
          "label": "Blood Pressure without posture",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Systolic BP",
              "type": "obs",
              "id": "systolicBp",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 90 || myValue > 120)",
                  "message": "Value is outside the normal range (90-120 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Diastolic BP",
              "type": "obs",
              "id": "diastolicBp",
              "questionOptions": {
                "rendering": "number",
                "concept": "5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 90)",
                  "message": "Value is outside the normal range (60-90 mmHg)."
                }
              ],
              "hideSteppers": true
            }
          ]
        }
      ]
    }
  ],
  "processor": "EncounterFormProcessor",
  "referencedForms": []
}