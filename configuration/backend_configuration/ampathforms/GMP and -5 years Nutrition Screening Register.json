        {
          "label": "Anthropometric Measurements (Screening)",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Weight (kg)",
              "type": "obs",
              "id": "screenWeight",
              "questionOptions": {
                "rendering": "number",
                "concept": "5089AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "max": "300",
                "step": "0.01"
              }
            },
            {
              "label": "Height / Length (cm)",
              "type": "obs",
              "id": "screenHeight",
              "questionOptions": {
                "rendering": "number",
                "concept": "5090AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "30",
                "max": "300",
                "step": "0.1"
              }
            },
            {
              "label": "Mid-Upper Arm Circumference (MUAC) (cm)",
              "type": "obs",
              "id": "screenMuac",
              "questionOptions": {
                "rendering": "number",
                "concept": "aae2be11-0e07-497d-8e7c-a5b74fbd7cb0",
                "min": "5",
                "max": "30",
                "step": "0.1"
              },
              "questionInfo": "One decimal place, e.g. 11.5"
            },
            {
              "label": "Bilateral Pitting Edema",
              "type": "obs",
              "id": "oedemaGrade",
              "questionOptions": {
                "rendering": "radio",
                "concept": "1f7ee031-c173-42be-b048-ab27024c818a",
                "answers": [
                  {
                    "concept": "1107AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Grade 0 (None)"
                  },
                  {
                    "concept": "165598AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Grade + (Mild - both feet/ankles)"
                  },
                  {
                    "concept": "165599AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Grade ++ (Moderate - feet, legs, hands, lower arms)"
                  },
                  {
                    "concept": "165600AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Grade +++ (Severe - generalized/anasarca)"
                  }
                ]
              }
            },
            {
              "label": "BMI (kg/m²)",
              "type": "obs",
              "id": "screenBmi",
              "readonly": true,
              "questionOptions": {
                "rendering": "number",
                "concept": "1342AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "step": "0.01",
                "calculate": {
                  "calculateExpression": "(isEmpty(screenHeight) || isEmpty(screenWeight)) ? null : calcBMI(screenHeight,screenWeight)"
                }
              },
              "questionInfo": "Calculated automatically from Height and Weight."
            }
          ]
        },
