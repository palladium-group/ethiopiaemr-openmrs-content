              "questionOptions": {
                "rendering": "number",
                "concept": "5314AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "max": "60",
                "step": 0.1
              },
              "hideSteppers": true
            },
            {
              "label": "Birth weight (g)",
              "type": "obs",
              "id": "birthWeightGrams",
              "questionOptions": {
                "rendering": "number",
                "concept": "30415263-4758-6789-0123-456789345678",
                "min": "300",
                "max": "6000",
                "step": 1,
                "disallowDecimals": true
              },
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (myValue < 2500 || myValue > 4000)",
                  "message": "Outside 2500-4000 g (low or high birth weight)."
                }
              ]
            },
            {
              "label": "Weight for gestational age",
              "type": "obs",
              "id": "weightForGestationalAge",
              "questionOptions": {
                "rendering": "select",
