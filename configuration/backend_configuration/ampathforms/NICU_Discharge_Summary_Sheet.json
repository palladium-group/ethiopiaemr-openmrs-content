        {
          "label": "Vital signs and Anthropometric assessment upon discharge",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Blood pressure (mmHg)",
              "type": "obs",
              "id": "bp",
              "questionOptions": {
                "rendering": "text",
                "concept": "935e6ba6-c666-5296-8374-0360954d7834",
                "min": "0",
                "step": 0.01
              }
            },
            {
              "label": "Pulse rate (beats/min)",
              "type": "obs",
              "id": "pr",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "230",
                "disallowDecimals": true
              },
              "questionInfo": "Beats per minute.",
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (myValue < 100 || myValue > 160)",
                  "message": "Outside the neonatal range 100-160 beats/min."
                }
              ]
            },
            {
              "label": "Respiratory rate (breaths/min)",
              "type": "obs",
              "id": "rr",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "99",
                "disallowDecimals": true
              },
              "questionInfo": "Breaths per minute.",
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (myValue < 30 || myValue > 60)",
                  "message": "Outside the neonatal range 30-60 breaths/min."
                }
              ]
            },
            {
              "label": "Temperature (°C)",
              "type": "obs",
              "id": "temperature",
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "25",
                "step": 0.01,
                "max": "43"
              },
              "questionInfo": "Degrees Celsius, one decimal place.",
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && (myValue < 36.5 || myValue > 37.5)",
                  "message": "Outside the neonatal range 36.5-37.5 °C."
                }
              ]
            },
            {
              "label": "SpO2 (%)",
              "type": "obs",
              "id": "pso2",
              "questionOptions": {
                "rendering": "number",
                "concept": "5092aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "min": "0",
                "step": 1,
                "max": "100",
                "disallowDecimals": true
              },
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && myValue < 90",
                  "message": "SpO2 below 90%."
                }
              ]
            },
            {
              "label": "Weight (kg)",
              "type": "obs",
              "id": "wt",
              "questionOptions": {
                "rendering": "number",
                "concept": "5089AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 0.01,
                "max": "250"
              },
              "questionInfo": "Kilograms.",
              "hideSteppers": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "!isEmpty(myValue) && myValue > 10",
                  "message": "Above 10 kg: check the weight was entered in kg, not grams."
                }
              ]
            },
            {
              "label": "Length (cm)",
              "type": "obs",
              "id": "lt",
              "questionOptions": {
                "rendering": "number",
                "concept": "97d878cf-4807-480a-a236-8f8f416f7be1",
                "min": "0",
                "max": "100"
              },
              "hideSteppers": true
            },
            {
              "label": "Head circumference (cm)",
              "type": "obs",
              "id": "hc",
              "questionOptions": {
                "rendering": "number",
                "concept": "5314AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "max": "70"
              },
              "questionInfo": "Centimetres.",
              "hideSteppers": true
            }
          ]
