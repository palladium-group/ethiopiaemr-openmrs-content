            {
              "label": "Admission date and time",
              "type": "obs",
              "id": "admissionDate",
              "datePickerFormat": "both",
              "questionOptions": {
                "rendering": "datetime",
                "concept": "1640AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                }
              ]
            },
            {
              "label": "Discharge date and time",
              "type": "obs",
              "id": "dischargeDate",
              "datePickerFormat": "both",
              "questionOptions": {
                "rendering": "datetime",
                "concept": "1641AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                },
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && !isEmpty(admissionDate) && new Date(myValue) < new Date(admissionDate)",
                  "message": "Discharge cannot be before admission."
                }
              ]
            },
            {
              "label": "Length of stay (days)",
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "162196AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "calculate": {
                  "calculateExpression": "(isEmpty(admissionDate) || isEmpty(dischargeDate)) ? lengthOfStay : Math.max(0, Math.floor((new Date(dischargeDate) - new Date(admissionDate)) / 86400000))"
                },
                "disallowDecimals": true,
                "step": 1
              },
              "id": "lengthOfStay",
              "hideSteppers": true
            },
            {
              "label": "Length of stay, additional hours (0-23)",
              "type": "obs",
              "id": "lengthOfStayHours",
              "hideSteppers": true,
              "questionOptions": {
                "rendering": "number",
                "concept": "f6115464-77b5-4c47-8fd6-fbaf398b942b",
                "min": "0",
                "max": "23",
                "disallowDecimals": true,
                "step": 1,
                "calculate": {
                  "calculateExpression": "(isEmpty(admissionDate) || isEmpty(dischargeDate)) ? lengthOfStayHours : Math.max(0, Math.floor((new Date(dischargeDate) - new Date(admissionDate)) / 3600000)) % 24"
                }
              }
            },
            {
              "label": "Outcome",
              "type": "obs",
              "questionOptions": {
                "rendering": "textarea",
                "concept": "d2f8b5c1-3e49-4a6d-9b72-4c1e7a9f0b18"
              },
              "id": "outcome"
            }
          ]
        }
      ]
