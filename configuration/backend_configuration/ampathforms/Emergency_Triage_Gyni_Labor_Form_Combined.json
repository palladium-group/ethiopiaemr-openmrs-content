              "id": "usGaWeeks",
              "questionOptions": {
                "rendering": "number",
                "concept": "163166AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "disallowDecimals": true,
                "step": 1,
                "min": "0",
                "max": "45"
              },
              "hideSteppers": true
            },
            {
              "label": "Current gestational age (weeks, calculated)",
              "type": "obs",
              "questionOptions": {
                "rendering": "number",
                "concept": "1438AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "disallowDecimals": true,
                "step": 1,
                "min": "0",
                "max": "45",
                "calculate": {
                  "calculateExpression": "((!isEmpty(lnmp) ? Math.round((new Date((encDate ? encDate : new Date())).setHours(0,0,0,0) - new Date(lnmp).setHours(0,0,0,0)) / 86400000) : ((isEmpty(ultrasound) || isEmpty(usGaWeeks)) ? null : (Number(usGaWeeks) * 7) + Math.round((new Date((encDate ? encDate : new Date())).setHours(0,0,0,0) - new Date(ultrasound).setHours(0,0,0,0)) / 86400000))) === null || (!isEmpty(lnmp) ? Math.round((new Date((encDate ? encDate : new Date())).setHours(0,0,0,0) - new Date(lnmp).setHours(0,0,0,0)) / 86400000) : ((isEmpty(ultrasound) || isEmpty(usGaWeeks)) ? null : (Number(usGaWeeks) * 7) + Math.round((new Date((encDate ? encDate : new Date())).setHours(0,0,0,0) - new Date(ultrasound).setHours(0,0,0,0)) / 86400000))) < 0) ? null : Math.floor((!isEmpty(lnmp) ? Math.round((new Date((encDate ? encDate : new Date())).setHours(0,0,0,0) - new Date(lnmp).setHours(0,0,0,0)) / 86400000) : ((isEmpty(ultrasound) || isEmpty(usGaWeeks)) ? null : (Number(usGaWeeks) * 7) + Math.round((new Date((encDate ? encDate : new Date())).setHours(0,0,0,0) - new Date(ultrasound).setHours(0,0,0,0)) / 86400000))) / 7)"
                }
              },
              "id": "gestationalAge",
              "validators": []
            }
