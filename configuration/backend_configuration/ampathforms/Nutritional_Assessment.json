            {
              "label": "WFL/H (Z-score)",
              "type": "obs",
              "id": "wflHZScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "8c210363-d331-4199-a8df-3ab7e3b59c63",
                "calculate": {
                  "calculateExpression": "(isEmpty(heightM) || isEmpty(weightKg)) ? '' : ((calcWeightForHeightZscore(Number(heightM)*100,Number(weightKg)) == null) ? '' : Number(calcWeightForHeightZscore(Number(heightM)*100,Number(weightKg))))"
                }
              },
              "readonly": true,
              "hideSteppers": true,
              "hide": {
                "hideWhenExpression": "age >= 5"
              }
            },
            {
              "label": "WFA (z-score)",
              "type": "obs",
              "id": "wfaZscore",
              "questionOptions": {
                "rendering": "number",
                "concept": "162584AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
              },
              "hideSteppers": true,
              "hide": {
                "hideWhenExpression": "age >= 10"
              }
            },
            {
              "label": "HFA/LFA (z score)",
              "type": "obs",
              "id": "hfaLfaZScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "4966afa5-781a-4347-aae5-926831cdc63b",
                "calculate": {
                  "calculateExpression": "(isEmpty(heightM)) ? '' : ((calcHeightForAgeZscore(Number(heightM)*100) == null) ? '' : Number(calcHeightForAgeZscore(Number(heightM)*100)))"
                }
              },
              "readonly": true,
              "hideSteppers": true,
              "hide": {
                "hideWhenExpression": "age >= 19"
              }
            },
            {
              "label": "BMI/Age(>5-19)(Z-score)",
              "type": "obs",
              "id": "bmiAge519ZScore",
