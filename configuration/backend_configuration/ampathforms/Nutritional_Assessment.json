                "rendering": "number",
                "concept": "6f337537-792b-576f-82e6-d11a5ac4a45d",
                "calculate": {
                  "calculateExpression": "(isEmpty(heightM) || isEmpty(weightKg)) ? '' : ((calcBMIForAgeZscore(Number(heightM)*100,Number(weightKg)) == null) ? '' : Number(calcBMIForAgeZscore(Number(heightM)*100,Number(weightKg))))"
                }
              },
              "hideSteppers": true,
              "readonly": true,
              "hide": {
                "hideWhenExpression": "age < 5 || age >= 19"
              }
            },
