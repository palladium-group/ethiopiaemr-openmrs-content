                  }
                ]
              }
            },
            {
              "label": "Consciousness",
              "type": "obs",
              "id": "consciousness",
              "questionOptions": {
                "rendering": "select",
                "concept": "162643AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "answers": [
                  {
                    "concept": "9694701e-109a-41d3-8adb-8f07670fbcb5",
                    "label": "Alert"
                  },
                  {
                    "concept": "0dc8ced0-a382-4ae5-8700-0d3ef2441cd4",
                    "label": "Reacts to Voice"
                  },
                  {
                    "concept": "8071ff18-fc2b-4a5d-bc9a-794c6fb8c937",
                    "label": "Reacts to pain"
                  },
                  {
                    "concept": "60c7864e-4a90-468f-81bf-94a6dea9c898",
                    "label": "Unresponsive"
                  }
                ]
              }
            },
            {
              "label": "Consciousness score",
              "type": "obs",
              "id": "consciousnessScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "e4050494-32d0-4ffb-8e5d-26ececf51c98",
                "min": "0",
                "step": 1,
                "calculate": {
                  "calculateExpression": "(isEmpty(consciousness) ? '' : (consciousness === '9694701e-109a-41d3-8adb-8f07670fbcb5' ? 0 : 3))"
                }
              },
              "hideSteppers": true,
              "readonly": true
            },
            {
              "label": "Total early warning score (NEWS2)",
              "type": "obs",
              "id": "totalEwsScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "f92b1339-461a-5b9d-90ed-4b322d305708",
                "min": "0",
                "step": 1,
                "calculate": {
                  "calculateExpression": "(isEmpty(pulseRate) || isEmpty(respiratoryRate) || isEmpty(systolic) || isEmpty(spo2) || isEmpty(oxygenDelivery) || isEmpty(temperature) || isEmpty(consciousness)) ? '' : ((isEmpty(pulseRate) ? '' : (Number(pulseRate) <= 40 ? 3 : Number(pulseRate) <= 50 ? 1 : Number(pulseRate) <= 90 ? 0 : Number(pulseRate) <= 110 ? 1 : Number(pulseRate) <= 130 ? 2 : 3)) + (isEmpty(respiratoryRate) ? '' : (Number(respiratoryRate) <= 8 ? 3 : Number(respiratoryRate) <= 11 ? 1 : Number(respiratoryRate) <= 20 ? 0 : Number(respiratoryRate) <= 24 ? 2 : 3)) + (isEmpty(systolic) ? '' : (Number(systolic) <= 90 ? 3 : Number(systolic) <= 100 ? 2 : Number(systolic) <= 110 ? 1 : Number(systolic) <= 219 ? 0 : 3)) + (isEmpty(spo2) ? '' : (Number(spo2) <= 91 ? 3 : Number(spo2) <= 93 ? 2 : Number(spo2) <= 95 ? 1 : 0)) + (isEmpty(oxygenDelivery) ? '' : (oxygenDelivery === '81341AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' ? 2 : 0)) + (isEmpty(temperature) ? '' : (Number(temperature) <= 35.0 ? 3 : Number(temperature) <= 36.0 ? 1 : Number(temperature) <= 38.0 ? 0 : Number(temperature) <= 39.0 ? 1 : 2)) + (isEmpty(consciousness) ? '' : (consciousness === '9694701e-109a-41d3-8adb-8f07670fbcb5' ? 0 : 3)))"
                }
              },
              "hideSteppers": true,
              "readonly": true,
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue !== \"\" && Number(myValue) >= 5",
                  "message": "NEWS2 score 5 or more: urgent clinical review (7 or more: emergency response)."
                }
              ]
            },
            {
