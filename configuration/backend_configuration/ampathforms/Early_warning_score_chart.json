{
  "name": "Early warning score chart",
  "description": "Scores each vital sign, including pulse, respiratory rate, blood pressure, oxygen saturation and flow, temperature and level of consciousness, to produce an early warning score for spotting deteriorating patients; also records blood sugar and pain.",
  "version": "1.0",
  "published": true,
  "uuid": "e5c88220-8456-53fd-926d-4a87edeaab37",
  "retired": false,
  "encounter": "Consultation",
  "pages": [
    {
      "label": "Visit Details",
      "sections": [
        {
          "label": "Encounter Details",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Visit date:",
              "type": "encounterDatetime",
              "required": "true",
              "id": "encDate",
              "questionOptions": {
                "rendering": "date"
              },
              "validators": [
                {
                  "type": "date",
                  "allowFutureDates": "false"
                }
              ],
              "readonly": true
            },
            {
              "label": "Provider:",
              "type": "encounterProvider",
              "required": "true",
              "questionOptions": {
                "rendering": "ui-select-extended",
                "isSearchable": true
