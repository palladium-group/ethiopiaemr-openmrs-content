                  }
                }
              },
              "id": "encLocation",
              "readonly": true
            }
          ]
        }
      ]
    },
    {
      "label": "Early warning score chart Assessment",
      "sections": [
        {
          "label": "Assessment",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Pulse rate (beats/min)",
              "type": "obs",
              "id": "pulseRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "230",
                "disallowDecimals": true
              },
              "questionInfo": "Normal range: 60-100 beats/min",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 100)",
                  "message": "Value is outside the normal range (60-100 bpm)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Pulse rate score",
              "type": "obs",
              "id": "pulseRateScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "98e1ae72-e087-434b-bbc3-806bbed78cd4",
                "min": "0",
                "step": 1,
                "calculate": {
                  "calculateExpression": "(isEmpty(pulseRate) ? '' : (Number(pulseRate) <= 40 ? 3 : Number(pulseRate) <= 50 ? 1 : Number(pulseRate) <= 90 ? 0 : Number(pulseRate) <= 110 ? 1 : Number(pulseRate) <= 130 ? 2 : 3))"
                }
              },
              "hideSteppers": true,
              "readonly": true
            },
            {
              "label": "Respiratory rate (breaths/min)",
              "type": "obs",
              "id": "respiratoryRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "99",
                "disallowDecimals": true
              },
              "questionInfo": "Normal range: 16-24 breaths/min",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 16 || myValue > 24)",
                  "message": "Value is outside the normal range (16-24 breaths/min)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Respiratory rate score",
              "type": "obs",
              "id": "respiratoryRateScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "33527161-9d15-5685-a40c-db78faaa5e1d",
                "min": "0",
                "step": 1,
                "calculate": {
                  "calculateExpression": "(isEmpty(respiratoryRate) ? '' : (Number(respiratoryRate) <= 8 ? 3 : Number(respiratoryRate) <= 11 ? 1 : Number(respiratoryRate) <= 20 ? 0 : Number(respiratoryRate) <= 24 ? 2 : 3))"
                }
              },
              "hideSteppers": true,
              "readonly": true
            },
            {
              "label": "Systolic BP (mmHg)",
              "type": "obs",
              "id": "systolic",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "250",
                "disallowDecimals": true
              },
              "questionInfo": "Normal range: 90-120 mmHg",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 90 || myValue > 120)",
                  "message": "Value is outside the normal range (90-120 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Diastolic BP (mmHg)",
              "type": "obs",
              "id": "diastolic",
              "questionOptions": {
                "rendering": "number",
                "concept": "5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "150",
                "disallowDecimals": true
              },
              "questionInfo": "Normal range: 60-90 mmHg",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 90)",
                  "message": "Value is outside the normal range (60-90 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Systolic BP score",
              "type": "obs",
              "id": "systolicScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "6d997573-0801-43cf-b461-1a4dc3b0f74d",
                "min": "0",
                "step": 1,
                "calculate": {
                  "calculateExpression": "(isEmpty(systolic) ? '' : (Number(systolic) <= 90 ? 3 : Number(systolic) <= 100 ? 2 : Number(systolic) <= 110 ? 1 : Number(systolic) <= 219 ? 0 : 3))"
                }
              },
              "hideSteppers": true,
              "readonly": true
            },
            {
              "label": "SpO2 (%)",
              "type": "obs",
              "id": "spo2",
              "questionOptions": {
                "rendering": "number",
                "concept": "5092AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": 1,
                "max": "100",
                "disallowDecimals": true
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && myValue <= 90",
                  "message": "SPO2 is below the normal range (>90%)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "SpO2 score",
              "type": "obs",
              "id": "spo2Score",
              "questionOptions": {
                "rendering": "number",
                "concept": "0ad48464-138d-4bea-9b55-e3b284e4fc91",
                "min": "0",
                "step": 1,
                "calculate": {
                  "calculateExpression": "(isEmpty(spo2) ? '' : (Number(spo2) <= 91 ? 3 : Number(spo2) <= 93 ? 2 : Number(spo2) <= 95 ? 1 : 0))"
                }
              },
              "hideSteppers": true,
              "readonly": true
            },
            {
              "label": "Breathing room air or supplemental oxygen?",
              "type": "obs",
              "id": "oxygenDelivery",
              "questionOptions": {
                "rendering": "radio",
                "concept": "0a1b6af2-5fa3-40b2-858a-791c237b44af",
                "answers": [
                  {
                    "concept": "162735AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Room air"
                  },
                  {
                    "concept": "81341AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                    "label": "Supplemental oxygen"
                  }
                ]
              }
            },
            {
              "label": "If supplemental oxygen given, oxygen flow rate (L/min)",
              "type": "obs",
              "id": "oxygenFlowRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "ac21a619-68c5-47e6-9b56-cc897dc964c1",
                "min": "0",
                "step": 0.01
              },
              "hideSteppers": true,
              "hide": {
                "hideWhenExpression": "oxygenDelivery !== '81341AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'"
              }
            },
            {
              "label": "Supplemental oxygen score",
              "type": "obs",
              "id": "oxygenFlowRateScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "70f44013-3dff-4ded-ba9a-b1622d8bc82e",
                "min": "0",
                "step": 1,
                "calculate": {
                  "calculateExpression": "(isEmpty(oxygenDelivery) ? '' : (oxygenDelivery === '81341AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' ? 2 : 0))"
                }
              },
              "hideSteppers": true,
              "readonly": true
            },
            {
              "label": "Temperature (°C)",
              "type": "obs",
              "id": "temperature",
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "25",
                "step": 0.01,
                "max": "43"
              },
              "questionInfo": "Normal range: 36.5-37.5 °C",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 35 || myValue > 37.5)",
                  "message": "Value is outside the normal range (35-37.5 deg C)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Temperature score",
              "type": "obs",
              "id": "temperatureScore",
              "questionOptions": {
                "rendering": "number",
                "concept": "aa4820ee-d14b-5b9c-9a05-ee5526c8de17",
                "min": "0",
                "step": 1,
                "calculate": {
                  "calculateExpression": "(isEmpty(temperature) ? '' : (Number(temperature) <= 35.0 ? 3 : Number(temperature) <= 36.0 ? 1 : Number(temperature) <= 38.0 ? 0 : Number(temperature) <= 39.0 ? 1 : 2))"
                }
              },
              "hideSteppers": true,
              "readonly": true
            },
            {
              "label": "RBS(mg/dl)",
              "type": "obs",
              "id": "rbsMgDl",
              "questionOptions": {
                "rendering": "number",
                "concept": "887AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0"
              },
              "hideSteppers": true
            },
            {
