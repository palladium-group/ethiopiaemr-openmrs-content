              "label": "Systolic BP (mmHg)",
              "type": "obs",
              "id": "systolicBp",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Millimetres of mercury.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 90 || myValue > 120)",
                  "message": "Value is outside the normal range (90-120 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
