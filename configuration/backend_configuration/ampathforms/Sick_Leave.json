                "concept": "e420f014-c133-5ce8-b65b-12e08d7cdf85",
                "min": "0",
                "step": 1,
                "disallowDecimals": true,
                "calculate": {
                  "calculateExpression": "(isEmpty(leaveStartDate) || isEmpty(leaveEndDate)) ? '' : Math.round((new Date(leaveEndDate) - new Date(leaveStartDate)) / 86400000) + 1"
                }
              },
              "readonly": true,
              "hideSteppers": true
            },
