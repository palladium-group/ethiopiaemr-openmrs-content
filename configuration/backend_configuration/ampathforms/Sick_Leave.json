                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && !isEmpty(leaveStartDate) && new Date(myValue) < new Date(leaveStartDate)",
                  "message": "Leave end date cannot be before the start date."
                }
              ]
            },
