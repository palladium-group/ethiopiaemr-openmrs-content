    {
      "label": "Vital Sign for School Age Children (6-12) Assessment",
      "sections": [
        {
          "label": "Assessment",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Pulse rate (beats/min)",
              "type": "obs",
              "id": "pulseRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Beats per minute.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 60 || myValue > 100)",
                  "message": "Value is outside the normal range (60-100 bpm)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Temperature (°C)",
              "type": "obs",
              "id": "temperature",
              "questionOptions": {
                "rendering": "number",
                "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Degrees Celsius, one decimal place.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 35 || myValue > 37.5)",
                  "message": "Value is outside the normal range (35-37.5 deg C)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Respiratory Rate (breaths/min)",
              "type": "obs",
              "id": "respiratoryRate",
              "questionOptions": {
                "rendering": "number",
                "concept": "5242AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Breaths per minute.",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 16 || myValue > 24)",
                  "message": "Value is outside the normal range (16-24 breaths/min)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "SPO2",
              "type": "obs",
              "id": "spo2",
              "questionOptions": {
                "rendering": "number",
                "concept": "5092aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "min": "0",
                "step": "0.01"
              },
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && myValue <= 90",
                  "message": "SPO2 is below the normal range (>90%)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Weight (kg)",
              "type": "obs",
              "id": "weight",
              "questionOptions": {
                "rendering": "number",
                "concept": "5089AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Kilograms.",
              "hideSteppers": true
            },
            {
              "label": "Height (cm)",
              "type": "obs",
              "id": "height",
              "questionOptions": {
                "rendering": "number",
                "concept": "5090AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Centimetres.",
              "hideSteppers": true
            },
            {
              "label": "BMI",
              "type": "obs",
              "id": "bmi",
              "questionOptions": {
                "rendering": "number",
                "concept": "8dbc97c1-cc29-4823-b10e-58f03773588d",
                "min": "0",
                "step": "0.01",
                "calculate": {
                  "calculateExpression": "calcBMI(height,weight)"
                }
              },
              "hideSteppers": true
            },
            {
              "label": "RBS",
              "type": "obs",
              "id": "rbs",
              "questionOptions": {
                "rendering": "number",
                "concept": "887aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              },
              "hideSteppers": true
            }
          ]
        },
        {
