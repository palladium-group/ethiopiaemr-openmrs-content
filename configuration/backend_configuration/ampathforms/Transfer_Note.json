            {
              "label": "Systolic blood pressure (mmHg)",
              "type": "obs",
              "id": "systolicBloodPressure",
              "questionOptions": {
                "rendering": "number",
                "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "min": "0",
                "step": "0.01"
              },
              "questionInfo": "Normal range: 90-120 mmHg",
              "validators": [
                {
                  "type": "js_expression",
                  "warnsWhenExpression": "myValue && (myValue < 90 || myValue > 120)",
                  "message": "Value is outside the normal range (90-120 mmHg)."
                }
              ],
              "hideSteppers": true
            },
            {
              "label": "Diastolic blood pressure (mmHg)",
