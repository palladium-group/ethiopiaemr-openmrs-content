<config>
    <globalProperties>
        <!--
            Master switch for the SHR administration feature (the outbox screen at
            /openmrs/spa/shr-admin and the endpoints behind it).

            Seeded false so the feature ships dormant: a release can carry the code to production
            without exposing it. Set to true in an environment once the feature is meant to be live
            there — no redeploy needed, and it can be switched back off if a run goes badly.

            Distinct from the 'Manage SHR Outbox' privilege, which decides which users may work the
            outbox once this switch is on. Both must be satisfied.
        -->
        <globalProperty>
            <property>ethiopiaemrshr.shrAdminEnabled</property>
            <value>false</value>
        </globalProperty>
    </globalProperties>
</config>
