<config>
    <globalProperties>
        <!--
            Suppress Java stack traces from webservices.rest error responses.

            The webservices.rest module ships this property defaulting to "true", and its own
            config.xml states: "the recommendation is to keep it as 'false', from the Security
            perspective, to avoid leaking implementation details".
        -->
        <globalProperty>
            <property>webservices.rest.enableStackTraceDetails</property>
            <value>false</value>
        </globalProperty>
    </globalProperties>
</config>
