<config>
    <globalProperties>
        <!-- Boolean obs require concept.true / concept.false to point at real
             concepts. The base DB shipped them as 1/2 (non-existent), which made
             ALL Boolean form fields fail to save. Set them to the CIEL Yes/No
             concepts (1065 / 1066). Loaded via the Initializer globalproperties
             domain. -->
        <globalProperty>
            <property>concept.true</property>
            <value>1065</value>
        </globalProperty>
        <globalProperty>
            <property>concept.false</property>
            <value>1066</value>
        </globalProperty>
    </globalProperties>
</config>
